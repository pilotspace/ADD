# Python
__pycache__/
*.py[cod]

# Python packaging build artifacts (the PyPI add-method package)
# The bundled data (src/add_method/_bundled/) IS committed — it is generated by
# scripts/prepare_bundle.py and guarded by tooling/test_bundle_parity.py.
*.egg-info/
build/
dist/
.eggs/

# Node
node_modules/
*.tgz

# MkDocs build output (the GitHub Pages docs site is built from add-method/docs/;
# the static site/ is a build artifact, deployed by CI — never committed)
site/

# OS
.DS_Store

# Backups left beside a file the installer rewrites in place
*.bak

# Tooling / MCP workspace artifacts (not part of the product)
.serena/

# ADD — the repo's OWN 4.0 bundle, which is how this repo dogfoods what it ships. Every
# authored file is tracked. The persona corpus the installer vendors is NOT: it is copied
# from add-method/ on install. The 3.x bundle's history lives in archive/add-3x-bundle/.
.add/personas-teacher/
.add/personas-index/
# A 3.x engine left behind by an old install — the 4.0 installer removes it.
.add/tooling/
tmp/

# Agent worktree scratch (isolation: worktree runs) — local, never committed
.claude/worktrees/

# add-method/ is the PACKAGE SOURCE, never an ADD-managed project. A stray
# `init` there (e.g. during installer smoke tests) must never be committed.
add-method/.add/
add-method/.claude/
add-method/AGENTS.md
add-method/CLAUDE.md

# Benchmark run outputs (transcripts, per-arm workspaces, run records) are
# generated artifacts of later bench-runner/bench-scoring tasks — never
# committed. The benchmark/ scaffold itself (workload/arms/schema) IS tracked.
# One pattern covers every run directory, including dated ones like
# runs-remeasure-2026-07-23/. A bare `benchmark/` sat here instead and ignored the
# WHOLE tree — invisible, because git does not apply ignore rules to already-tracked
# files, so the 124 tracked scaffold files kept working while every NEW benchmark
# file was silently unstageable.
benchmark/runs*/