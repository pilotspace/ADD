{
  "name": "@pilotspace/add",
  "version": "3.0.0",
  "description": "ADD (AI-Driven Development) 2.0. The agent is the hands; ADD is the memory, judgment, and conscience \u2014 a minimal, state-tracked skill: one freeze per feature, trust from passing tests, state on disk so context rot never survives a new session.",
  "bin": {
    "add": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tooling -p 'test_*.py'",
    "prepublishOnly": "python3 -m unittest discover -s tooling -p 'test_packaging.py'"
  },
  "files": [
    "bin/",
    "skill/",
    "agents/",
    "tooling/add.py",
    "tooling/cli.py",
    "!**/*.pyc",
    "!**/__pycache__",
    "tooling/templates/",
    "personas-teacher/",
    "personas-index/",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "GETTING-STARTED.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "ai-driven-development",
    "add",
    "aidd",
    "claude-code",
    "skill",
    "tdd",
    "spec-driven",
    "agent",
    "methodology"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Tin Dang <tindang.ht97@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pilotspace/ADD.git"
  },
  "homepage": "https://pilotspace.github.io/ADD/",
  "bugs": {
    "url": "https://github.com/pilotspace/ADD/issues"
  }
}
