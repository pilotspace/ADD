{
  "model": [
    { "id": "claude-sonnet-rag", "version": "2025-09-01" }
  ],
  "request_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["question"],
    "properties": {
      "question": { "type": "string", "minLength": 1 },
      "top_k": { "type": "integer", "minimum": 1, "maximum": 10, "default": 4 }
    }
  },
  "response_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": ["answer", "relevant_chunk_ids", "confidence"],
    "properties": {
      "answer": { "type": "string" },
      "relevant_chunk_ids": { "type": "array", "items": { "type": "string" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  },
  "reader_policy": "lenient",
  "guardrails": ["pii", "injection", "toxicity", "refusal"],
  "idempotency": { "no_side_effect": true },
  "retry": { "max": 2, "backoff": "exponential", "jitter": true },
  "budget": {
    "latency_ms": { "p50": 800, "p90": 1800, "p99": 3000 },
    "cost_per_req": 0.004
  },
  "train_only_transforms": ["chunk_embedding_index", "bm25_idf_table"]
}
